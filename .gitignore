# Build output
dist/
build/

# Dependencies
node_modules/

# TypeScript incremental build cache
*.tsbuildinfo
tsconfig.tsbuildinfo

# Test coverage
coverage/
.nyc_output/

# Environment variables — NEVER commit real credentials
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Lock files (keep only the one you use)
# Uncomment the ones you DON'T use:
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Temporary files
tmp/
temp/
*.tmp
*.temp
